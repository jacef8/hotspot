{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{6}$/)",

        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id','name','role']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('role').isString() && newData.child('role').val().length <= 12"
          }
        },

        "events": {
          "$eventId": {
            ".validate": "newData.hasChild('type') && newData.child('type').isString() && newData.child('type').val().length <= 32"
          }
        }
      }
    }
  }
}
